<Project>
  <Target Name="ValidateHoneycombBuildType" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(BuildType)' != 'Alpha' And '$(BuildType)' != 'Debug' And '$(BuildType)' != 'Beta' And '$(BuildType)' != 'Release'"
      Text="BuildType must be Alpha, Debug, Beta, or Release. Current value: '$(BuildType)'." />
  </Target>

  <Target Name="SetHoneycombVersionMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="BuildNumber" Value="$(BuildNumber)" />
      <AssemblyMetadata Include="BuildType" Value="$(BuildType)" />
    </ItemGroup>
  </Target>

  <Target
    Name="IncrementLocalBuildNumber"
    AfterTargets="Build"
    Condition="'$(DesignTimeBuild)' != 'true' And '$(HoneycombBuildNumberOverridden)' != 'true' And '$(MSBuildProjectName)' == 'Honeycomb.UI'">
    <PropertyGroup>
      <HoneycombNextBuildNumber>$([MSBuild]::Add($(BuildNumber), 1))</HoneycombNextBuildNumber>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(HoneycombBuildNumberFile)"
      Lines="$(HoneycombNextBuildNumber)"
      Overwrite="true" />
  </Target>
</Project>
